@inject RoleServices oRoleServices
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

@if (oRole is null)
{
    <h3>Cargando...</h3>
}
else
{
    <EditForm EditContext="@editContext" @key="editContext" OnValidSubmit="@guardar">
        <Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

        <DataAnnotationsValidator />

        <div class="mt-3">
            <label>Id Rol</label>
            <NumberInput readonly class="form-control" @bind-Value="oRole.RoleId" />
        </div>

        <div class="mt-3">
            <label>Descripción</label>
            <TextInput class="form-control" @bind-Value="oRole.RoleName" />
            <ValidationMessage For="(()=>oRole.RoleName)" />
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">@((oRole?.RoleId > 0) ? "Actualizar" : "Guardar")</button>
            <button class="btn btn-warning" type="button" @onclick="(()=>ResetForm())">Limpiar</button>
        </div>
    </EditForm>
}

@code {
    public RolFormAdd oRole;
    private EditContext editContext;

    // Toasts
    List<ToastMessage> messages = new();
    private void ShowMessage(ToastType type, string titulo, string help, string mensaje)
        => messages.Add(new ToastMessage { Type = type, Title = titulo, HelpText = help, Message = mensaje });

    protected override async Task OnInitializedAsync()
    {
        oRoleServices.OnEdit += recuperarRol;
        oRole = new RolFormAdd();
        editContext = new EditContext(oRole);
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        oRoleServices.OnEdit -= recuperarRol;
    }

    private async Task guardar()
    {
        bool ok = (oRole.RoleId > 0)
            ? await oRoleServices.editar(oRole)
            : await oRoleServices.agregar(oRole);

        if (ok)
        {
            ShowMessage(ToastType.Success, "Rol Molit", $"Molit - {DateTime.Now}",
                oRole.RoleId > 0 ? "Rol actualizado correctamente" : "Rol agregado correctamente");

            await ResetForm();
            oRoleServices.notificarCambios();
        }
        else
        {
            ShowMessage(ToastType.Danger, "Rol Molit", $"Molit:Error - {DateTime.Now}",
                oRole.RoleId > 0 ? "No se pudo actualizar el rol" : "No se pudo guardar el rol");
        }
    }

    private Task ResetForm()
    {
        oRole = new RolFormAdd();
        editContext = new EditContext(oRole);   // ✅ rebind + limpia validaciones
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task recuperarRol(int id)
    {
        var rol = await oRoleServices.recuperarRole(id) ?? new RolFormAdd();
        oRole = rol;
        editContext = new EditContext(oRole);   // ✅ clave para que los inputs muestren los nuevos valores
        await InvokeAsync(StateHasChanged);
    }
}
