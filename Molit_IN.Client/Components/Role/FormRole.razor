@inject RoleServices oRoleServices


@if (oRole is null )
{
    <h3>Cargando...</h3>
}
else
{
    <EditForm Model="@oRole" OnValidSubmit="@guardar">

        <Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

        <DataAnnotationsValidator />
        <div class="mt-3">
            @* <span class="input-group-text" id="inputGroup-sizing-sm">Small</span> *@
            <label>Id Rol</label>
            <NumberInput readonly class="form-control" @bind-Value="oRole.RoleId" />
        </div>
        <div class="mt-3">
            <label>Descripción</label>
            <TextInput class="form-control" @bind-Value="oRole.RoleName" />
            <ValidationMessage For="(()=>oRole.RoleName)" />
        </div>
        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Guardar</button>
            <button class="btn btn-warning" @onclick="(()=>limpiar())" type="button">Limpiar</button>

        </div>

    </EditForm>

}


@code {
    public RolFormAdd oRole; // { get; set; } = new UsuarioFormAddCLS();

    //esto es para las alertas.
    List<ToastMessage> messages = new List<ToastMessage>();
    private void ShowMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => messages.Add(CreateToastMessage(toastType, titulo, textosecundario, mensaje));
    //fin para las alertas.

    private ToastMessage CreateToastMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => new ToastMessage
        {
            Type = toastType,
            Title = titulo,
            HelpText = textosecundario,
            Message = mensaje,
        };

    protected override async Task OnInitializedAsync()
    {
        oRoleServices.OnEdit += recuperarRol;
        oRole = new RolFormAdd();
    }

     private async Task guardar()
    {
        var respuesta = await oRoleServices.agregar(oRole);
        if(respuesta == true)
        {
            ShowMessage(ToastType.Success, "Rol Molit", $"Molit - {DateTime.Now}", $"Registro agregado correctamente! - {DateTime.Now}");
            oRole = new RolFormAdd();
        }
        else
        {
            ShowMessage(ToastType.Success, "Rol Molit", $"Molit:Error - {DateTime.Now}", $"Error: No se ha podido guardar el registro- {DateTime.Now}");
        }
   
        await Task.CompletedTask;

    }

    private async Task limpiar()
    {
        oRole = new RolFormAdd();
        await Task.CompletedTask;

    }


    private async Task recuperarRol(int id)
    {
        oRole = await oRoleServices.recuperarRole(id);

        StateHasChanged();
        await Task.CompletedTask;

    }
}
