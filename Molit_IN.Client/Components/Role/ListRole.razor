@inject RoleServices oRoleServices
@inject NavigationManager navigationManager

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

@if (lista is null)
{
    <h3>Cargando...</h3>
}
else
{
    <Grid TItem="RolListCLS"
          @ref="miGrid"
          Class="table table-hover table-bordered table-striped table-sm"
          DataProvider="RolesDataProvider"
          AllowPaging="true"
          PageSize="10"
          AllowFiltering="true"
          Responsive="true">

        <GridColumns>
            <GridColumn TItem="RolListCLS" HeaderText="Id" Filterable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.RoleId
            </GridColumn>
            <GridColumn TItem="RolListCLS" HeaderText="Descripción" PropertyName="RoleName">
                @context.RoleName
            </GridColumn>
            <GridColumn TItem="RolListCLS" Filterable="false" HeaderText="Operaciones" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                <Button @onclick="@(() => editar(@context.RoleId))" Color="ButtonColor.Warning" Size="ButtonSize.Small"><Icon Name="IconName.PencilFill" /></Button>
                <Button @onclick="@(() => eliminar(@context.RoleId))" Color="ButtonColor.Danger" Size="ButtonSize.Small"><Icon Name="IconName.Trash2Fill" /></Button>
            </GridColumn>
        </GridColumns>

    </Grid>

}
@code {
    public List<RolListCLS> lista; //= new List<UsuarioListCLS>();
    private IEnumerable<RolListCLS> Roles = default!;
    private Grid<RolListCLS> miGrid; // Asegúrate de que el tipo corresponda al componente
    //esto es para las alertas.
    List<ToastMessage> messages = new List<ToastMessage>();
    private void ShowMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => messages.Add(CreateToastMessage(toastType, titulo, textosecundario, mensaje));
    //fin para las alertas.

    private ToastMessage CreateToastMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => new ToastMessage
        {
            Type = toastType,
            Title = titulo,
            HelpText = textosecundario,
            Message = mensaje,
        };

    protected override async Task OnInitializedAsync()
    {
        lista = await oRoleServices.listarRole();
        oRoleServices.OnChange += refrezcarLista;
    }


    private async Task<GridDataProviderResult<RolListCLS>> RolesDataProvider(GridDataProviderRequest<RolListCLS> request)
    {
        //if (Usuarios is null) // pull employees only one time for client-side filtering, sorting, and paging
        Roles = lista; // call a service or an API to pull the employees
        return await Task.FromResult(request.ApplyTo(Roles));

    }

    public async Task refrezcarLista()
    {
        lista = await oRoleServices.listarRole();
        Roles = lista;
        // Llama al método de refresco del grid (si el grid lo expone)
        await miGrid.RefreshDataAsync(); // o Refresh() según lo que ofrezca la librería
        StateHasChanged();
    }


    private async Task editar(int id)
    {
        oRoleServices.notificarEdit(id);
        await Task.CompletedTask;
    }

    private async Task eliminar(int id)
    {
        bool exito = await oRoleServices.eliminar(id);
        if (exito == true)
        {
            ShowMessage(ToastType.Success, "Rol Molit", $"Molit - {DateTime.Now}", $"Registro se ha eliminado correctamente! - {DateTime.Now}");
        }
        else
        {
            ShowMessage(ToastType.Success, "Rol Molit", $"Molit:Error - {DateTime.Now}", $"Error: No se ha podido eliminar el registro - {DateTime.Now}");
        }
        await Task.CompletedTask;
    }

}
