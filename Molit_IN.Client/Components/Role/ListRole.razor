@implements IDisposable
@inject RoleServices oRoleServices
@inject NavigationManager navigationManager

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

@if (lista is null)
{
    <h3>Cargando...</h3>
}
else
{
    <Grid TItem="RolListCLS"
          @ref="miGrid"
          Class="table table-hover table-bordered table-striped table-sm"
          DataProvider="RolesDataProvider"
          AllowPaging="true"
          PageSize="10"
          AllowFiltering="true"
          Responsive="true">
        <GridColumns>
            <GridColumn TItem="RolListCLS" HeaderText="Id" Filterable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.RoleId
            </GridColumn>
            <GridColumn TItem="RolListCLS" HeaderText="Descripción" PropertyName="RoleName">
                @context.RoleName
            </GridColumn>
            <GridColumn TItem="RolListCLS" Filterable="false" HeaderText="Operaciones" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                <Button @onclick="@(() => editar(@context.RoleId))" Color="ButtonColor.Warning" Size="ButtonSize.Small"><Icon Name="IconName.PencilFill" /></Button>
                <Button @onclick="@(() => eliminar(@context.RoleId))" Color="ButtonColor.Danger" Size="ButtonSize.Small"><Icon Name="IconName.Trash2Fill" /></Button>
            </GridColumn>
        </GridColumns>
    </Grid>
}

@code {
    public List<RolListCLS> lista;
    private IEnumerable<RolListCLS> Roles = Enumerable.Empty<RolListCLS>();
    private Grid<RolListCLS> miGrid;

    List<ToastMessage> messages = new();
    private void ShowMessage(ToastType toastType, string titulo, string textosecundario, string mensaje)
        => messages.Add(new ToastMessage { Type = toastType, Title = titulo, HelpText = textosecundario, Message = mensaje });

    protected override async Task OnInitializedAsync()
    {
        lista = await oRoleServices.listarRole();
        oRoleServices.OnChange += refrezcarLista;
    }

    public void Dispose()
    {
        oRoleServices.OnChange -= refrezcarLista;
    }

    private Task<GridDataProviderResult<RolListCLS>> RolesDataProvider(GridDataProviderRequest<RolListCLS> request)
    {
        Roles = lista ?? Enumerable.Empty<RolListCLS>();
        return Task.FromResult(request.ApplyTo(Roles));
    }

    public async Task refrezcarLista()
    {
        lista = await oRoleServices.listarRole();
        Roles = lista;
        if (miGrid is not null) await miGrid.RefreshDataAsync();
        StateHasChanged();
    }

    private Task editar(int id)
    {
        oRoleServices.notificarEdit(id);   // ✅ evento via instancia compartida (Scoped)
        return Task.CompletedTask;
    }

    private async Task eliminar(int id)
    {
        bool exito = await oRoleServices.eliminar(id);
        if (exito)
        {
            ShowMessage(ToastType.Success, "Rol Molit", $"Molit - {DateTime.Now}", $"Registro eliminado correctamente!");
            await refrezcarLista();
        }
        else
        {
            ShowMessage(ToastType.Danger, "Rol Molit", $"Molit:Error - {DateTime.Now}", $"No se pudo eliminar el registro");
        }
    }
}
