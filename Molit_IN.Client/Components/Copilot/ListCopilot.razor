@inject CopilotServices oCopilotServices

@if (lista is null)
{
    <h3>Cargando...</h3>
}
else
{
    <Grid TItem="CopilotListCLS"
          @ref="miGrid"
          Class="table table-hover table-bordered table-striped table-sm"
          DataProvider="CopilotDataProvider"
          AllowPaging="true"
          PageSize="10"
          AllowFiltering="true"
          Responsive="true">
        <GridColumns>
            @* <GridColumn TItem="CopilotListCLS" HeaderText="Id" Filterable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.CopilotsId
            </GridColumn> *@

            <GridColumn TItem="CopilotListCLS" HeaderText="Nombre Completo" PropertyName="FullName">
                @context.FullName
            </GridColumn>

            <GridColumn TItem="CopilotListCLS" HeaderText="Tipo Licencia" PropertyName="LicenseType" TextAlignment="Alignment.Center">
                @context.LicenseType
            </GridColumn>

            <GridColumn TItem="CopilotListCLS" HeaderText="No. Licencia" PropertyName="LicenseNumber">
                @context.LicenseNumber
            </GridColumn>

            @* <GridColumn TItem="CopilotListCLS" HeaderText="Id Piloto" PropertyName="PilotId" TextAlignment="Alignment.Center">
                @context.PilotId
            </GridColumn> *@
            <GridColumn TItem="CopilotListCLS" HeaderText="Piloto Asociado" PropertyName="PilotFullName" TextAlignment="Alignment.Start">
                @context.PilotFullName
            </GridColumn>

            <GridColumn TItem="CopilotListCLS" Filterable="false" HeaderText="Operaciones" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                <Button @onclick="@(() => editar(@context.CopilotsId))" Color="ButtonColor.Warning" Size="ButtonSize.Small"><Icon Name="IconName.PencilFill" /></Button>
                <Button @onclick="@(() => eliminar(@context.CopilotsId))" Color="ButtonColor.Danger" Size="ButtonSize.Small"><Icon Name="IconName.Trash2Fill" /></Button>
            </GridColumn>
        </GridColumns>
    </Grid>
}

@code {
    [Parameter] public string branchcode { get; set; }

    // Callback al padre para mostrar toast
    [Parameter] public EventCallback<ToastMessage> OnToast { get; set; }

    public List<CopilotListCLS> lista;
    private IEnumerable<CopilotListCLS> Copilot = default!;
    private Grid<CopilotListCLS> miGrid;

    protected override async Task OnInitializedAsync()
    {
        lista = await oCopilotServices.listar(branchcode);
        Copilot = lista;
        oCopilotServices.OnChange += refrezcarLista;
    }

    public async Task refrezcarLista()
    {
        lista = await oCopilotServices.listar(branchcode);
        Copilot = lista;
        if (miGrid is not null) await miGrid.RefreshDataAsync();
        StateHasChanged();
    }

    private Task<GridDataProviderResult<CopilotListCLS>> CopilotDataProvider(GridDataProviderRequest<CopilotListCLS> request)
    {
        Copilot = lista ?? Enumerable.Empty<CopilotListCLS>();
        return Task.FromResult(request.ApplyTo(Copilot));
    }

    private Task editar(int id)
    {
        oCopilotServices.notificarEdit(id);
        return Task.CompletedTask;
    }

    private async Task eliminar(int idcopilot)
    {
        bool ok = await oCopilotServices.eliminar(idcopilot);
        await OnToast.InvokeAsync(new ToastMessage
            {
                Type = ok ? ToastType.Success : ToastType.Danger,
                Title = "Copiloto Molit",
                HelpText = $"Molit - {DateTime.Now}",
                Message = ok ? "Registro se ha eliminado correctamente" : "Error: No se ha podido eliminar el registro"
            });

        if (ok && miGrid is not null)
        {
            await refrezcarLista();
        }
    }

    public void Dispose()
    {
        oCopilotServices.OnChange -= refrezcarLista;
    }
}
