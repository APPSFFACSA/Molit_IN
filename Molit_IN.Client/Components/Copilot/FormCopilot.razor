@inject CopilotServices oCopilotServices
@inject PilotServices oPilotServices
@inject IYourImageService servicio
@implements IDisposable

@if (oCopilot is null)
{
    <h3>Cargando...</h3>
}
else
{
    <EditForm Model="@oCopilot" OnValidSubmit="@guardar">
        <DataAnnotationsValidator />

        <div class="mt-3">
            <label>Código de Empleado</label>
            <TextInput class="form-control border border-2" @bind-Value="oCopilot.CodEmpleado" />
        </div>

        <div class="mt-3">
            <label>Nombre Completo</label>
            <TextInput class="form-control border border-2" @bind-Value="oCopilot.FullName" />
            <ValidationMessage For="(()=>oCopilot.FullName)" />
        </div>

        <div class="mt-3">
            <label>Edad</label>
            <NumberInput class="form-control border border-2" @bind-Value="oCopilot.Age" />
        </div>

        <div class="mt-3">
            <label>Seleccione Tipo De Licencia</label>
            <InputSelect @bind-Value="oCopilot.LicenseType" class="form-control border border-2">
                <option value="0">--Seleccione--</option>
                <option value="A">Tipo A</option>
                <option value="B">Tipo B</option>
                <option value="C">Tipo C</option>
                <option value="M">Tipo M</option>
                <option value="E">Tipo E</option>
            </InputSelect>
        </div>

        <div class="mt-3">
            <label>No. Licencia</label>
            <TextInput class="form-control border border-2" @bind-Value="oCopilot.LicenseNumber" />
            <ValidationMessage For="(()=>oCopilot.LicenseNumber)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Foto de Licencia</label>
            <InputFile @key="fileInputKey" OnChange="OnFilesUploading" class="form-control border border-2" />
        </div>

        @if (!string.IsNullOrEmpty(imagePreview))
        {
            <div class="mb-3">
                <img src="@imagePreview"
                     width="200" height="200"
                     class="img-thumbnail border border-2"
                     style="cursor: zoom-in;"
                     @onclick="OpenImageDialog"
                     alt="Vista previa de la licencia" />
                <div class="form-text">Haz clic para ampliar</div>
            </div>
        }

        <div class="mt-3">
            <label>Piloto (asociado)</label>
            <InputSelect @bind-Value="oCopilot.PilotId" class="form-control border border-2">
                <option value="0">-- Seleccione un piloto --</option>
                @if (pilotos is not null)
                {
                    @foreach (var p in pilotos)
                    {
                        <option value="@p.PilotId">@p.FullName</option>
                    }
                }
            </InputSelect>
            <ValidationMessage For="(()=> oCopilot.PilotId)" />
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Guardar</button>
            <button class="btn btn-warning" @onclick="limpiar" type="button">Limpiar</button>
        </div>

        <Spinner Class="me-3" Type="SpinnerType.Dots" Color="SpinnerColor.Success" Size="SpinnerSize.Large" Visible="@visible" />
    </EditForm>
}

@* /* Dialog / Modal de imagen ampliada */ *@
@if (showImageDialog && !string.IsNullOrEmpty(imagePreview))
{
    <div class="image-dialog-backdrop" @onclick="BackdropClick" tabindex="0" @onkeydown="HandleKeyDown" autofocus>
        <div class="image-dialog" @onclick:stopPropagation>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="m-0">Foto de licencia</h5>
                <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseImageDialog"></button>
            </div>

            <div class="text-center">
                <img src="@imagePreview"
                     class="img-fluid rounded border border-2"
                     style="max-height: 80vh;"
                     alt="Imagen ampliada de la licencia" />
            </div>

            <div class="text-end mt-3">
                <button type="button" class="btn btn-secondary" @onclick="CloseImageDialog">Cerrar</button>
            </div>
        </div>
    </div>
}

<style>
    .image-dialog-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .image-dialog {
        width: min(90vw, 900px);
        background: #fff;
        border-radius: .75rem;
        padding: 1rem;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }
</style>

@code {
    [Parameter] public string branchcode { get; set; }

    // Callback para que el padre muestre un toast
    [Parameter] public EventCallback<ToastMessage> OnToast { get; set; }

    private string? imagePreview;
    public CopilotFormAddCLS oCopilot;
    private Guid fileInputKey = Guid.NewGuid();
    private bool visible = false;

    // Lista de pilotos para el combo
    private List<PilotListCLS> pilotos = new();
    private string? _prevBranchCode;

    // Estado del dialog
    private bool showImageDialog = false;

    protected override async Task OnInitializedAsync()
    {
        oCopilotServices.OnEdit += recuperar; // permite cargar en modo edición desde un listado
        oCopilot = new CopilotFormAddCLS();
        await CargarPilotosAsync();
        StateHasChanged();
    }

    // Si el branchcode cambia, recarga pilotos
    protected override async Task OnParametersSetAsync()
    {
        if (_prevBranchCode != branchcode)
        {
            _prevBranchCode = branchcode;
            await CargarPilotosAsync();

            // Si el piloto seleccionado ya no está en la sucursal, resetea
            if (oCopilot.PilotId != 0 && !pilotos.Any(x => x.PilotId == oCopilot.PilotId))
                oCopilot.PilotId = 0;
        }
    }

    public void Dispose() => oCopilotServices.OnEdit -= recuperar;

    private async Task CargarPilotosAsync()
    {
        pilotos = string.IsNullOrWhiteSpace(branchcode)
            ? new List<PilotListCLS>()
            : await oPilotServices.listar(branchcode);
    }

    private async Task guardar()
    {
        visible = true;
        try
        {
            oCopilot.BranchCode = branchcode;

            // Usamos POST (agregar) tanto para crear como para actualizar (CopilotController usa POST mixto)
            var ok = await oCopilotServices.agregar(oCopilot);

            if (ok)
            {
                await OnToast.InvokeAsync(new ToastMessage
                    {
                        Type = ToastType.Success,
                        Title = "Copiloto Molit",
                        HelpText = $"Molit - {DateTime.Now}",
                        Message = oCopilot.CopilotsId > 0 ? "Registro actualizado correctamente" : "Registro agregado correctamente"
                    });

                ClearImage();
                oCopilot = new CopilotFormAddCLS { BranchCode = branchcode, PilotId = 0 };
            }
            else
            {
                await OnToast.InvokeAsync(new ToastMessage
                    {
                        Type = ToastType.Danger,
                        Title = "Copiloto Molit",
                        HelpText = $"Molit:Error - {DateTime.Now}",
                        Message = "Error: No se ha podido guardar el registro"
                    });
            }
        }
        finally
        {
            visible = false;
        }
    }

    private Task limpiar()
    {
        oCopilot = new CopilotFormAddCLS { BranchCode = branchcode, PilotId = 0 };
        ClearImage();
        return Task.CompletedTask;
    }

    private async Task recuperar(int id)
    {
        var data = await oCopilotServices.recuperar(id);
        oCopilot = data ?? new CopilotFormAddCLS { BranchCode = branchcode, PilotId = 0 };

        // Asegura que la lista de pilotos esté cargada y consistente con branchcode
        await CargarPilotosAsync();
        if (oCopilot.PilotId != 0 && !pilotos.Any(x => x.PilotId == oCopilot.PilotId))
            oCopilot.PilotId = 0;

        imagePreview = servicio.VisualizarImagen(oCopilot.NamePhoto, oCopilot.LicensePhoto);
        StateHasChanged();
    }

    protected async Task OnFilesUploading(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Límite 15MB
        if (file.Size > 15_000_000)
        {
            await OnToast.InvokeAsync(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Archivo demasiado grande",
                    HelpText = "Límite 15 MB",
                    Message = $"El archivo {file.Name} excede el tamaño permitido."
                });
            return;
        }

        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 15_000_000).CopyToAsync(ms);

        oCopilot.LicensePhoto = ms.ToArray();
        oCopilot.NamePhoto = file.Name;
        imagePreview = servicio.VisualizarImagen(oCopilot.NamePhoto, oCopilot.LicensePhoto);
        StateHasChanged();
    }

    private void ClearImage()
    {
        oCopilot.LicensePhoto = Array.Empty<byte>();
        oCopilot.NamePhoto = null;
        imagePreview = null;
        showImageDialog = false;
        fileInputKey = Guid.NewGuid();
        StateHasChanged();
    }

    // --- Manejo de dialog ---
    private void OpenImageDialog()
    {
        if (!string.IsNullOrEmpty(imagePreview))
            showImageDialog = true;
    }

    private void CloseImageDialog()
    {
        showImageDialog = false;
    }

    private void BackdropClick(MouseEventArgs _)
    {
        // Clic en el fondo cierra el modal
        CloseImageDialog();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseImageDialog();
    }
}
