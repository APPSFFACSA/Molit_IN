@inject VehicleTypeServices oVehicleTypeServices
@* @inject SAPServices oSAPServices *@


@if (oVehicleType is null)
{
    <h3>Cargando...</h3>
}
else
{
    <EditForm Model="@oVehicleType" OnValidSubmit="@guardar">

        <Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

        <DataAnnotationsValidator />
        <div class="mt-3">
            <label>Id Vehicle Type</label>
            <NumberInput readonly class="form-control" @bind-Value="oVehicleType.IdVehicleType" />
        </div>
        <div class="mt-3">
            <label>Descripción</label>
            <TextInput class="form-control" @bind-Value="oVehicleType.DscriptionVehicle" />
            <ValidationMessage For="(()=>oVehicleType.DscriptionVehicle)" />
        </div>
@*         <div class="mt-3">
            <label>Proveedor</label>
            <InputSelect @bind-Value="oVehicleType.ItemCode" class="form-control">
                <option value="0">--Seleccione--</option>
                @foreach (var items in listaItemCode)
                {
                    <option value="@items.ItemCode"> @items.ItemCode </option>
                }
            </InputSelect>
        </div> *@

        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Guardar</button>
            <button class="btn btn-warning" @onclick="(()=>limpiar())" type="button">Limpiar</button>

        </div>

    </EditForm>

}



@code {
    public VehicleFormAddCLS oVehicleType; // { get; set; } = new UsuarioFormAddCLS();
    // public List<OITMCLS> listaItemCode; //  { get; set; } = new List<ListRoleCLS>();

    //esto es para las alertas.
    List<ToastMessage> messages = new List<ToastMessage>();
    private void ShowMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => messages.Add(CreateToastMessage(toastType, titulo, textosecundario, mensaje));
    //fin para las alertas.

    private ToastMessage CreateToastMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => new ToastMessage
        {
            Type = toastType,
            Title = titulo,
            HelpText = textosecundario,
            Message = mensaje,
        };

    protected override async Task OnInitializedAsync()
    {
        oVehicleTypeServices.OnEdit += recuperar;
        // listaItemCode = await oSAPServices.listar();
        oVehicleType = new VehicleFormAddCLS();
    }

    private async Task guardar()
    {
        var respuesta = await oVehicleTypeServices.agregar(oVehicleType);
        if (respuesta == true)
        {
            ShowMessage(ToastType.Success, "Tipo Vehiculo Molit", $"Molit - {DateTime.Now}", $"Registro agregado correctamente! - {DateTime.Now}");
            oVehicleType = new VehicleFormAddCLS();
        }
        else
        {
            ShowMessage(ToastType.Success, "Tipo Vehiculo", $"Molit:Error - {DateTime.Now}", $"Error: No se ha podido guardar el registro- {DateTime.Now}");
        }

        await Task.CompletedTask;

    }

    private async Task limpiar()
    {
        oVehicleType = new VehicleFormAddCLS();
        await Task.CompletedTask;

    }


    private async Task recuperar(int id)
    {
        oVehicleType = await oVehicleTypeServices.recuperar(id);
        StateHasChanged();
        await Task.CompletedTask;

    }
}
