@inject VehicleTypeServices oVehicleTypeServices
@inject NavigationManager navigationManager
@inject TokenService tokenService
<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

@if (lista is null)
{
    <h3>Cargando...</h3>
}
else
{
    <Grid TItem="VehicleListCLS"
          @ref="miGrid"
          Class="table table-hover table-bordered table-striped table-sm"
          DataProvider="VehiculoDataProvider"
          AllowPaging="true"
          PageSize="10"
          AllowFiltering="true"
          Responsive="true">

        <GridColumns>
            <GridColumn TItem="VehicleListCLS" HeaderText="Id" Filterable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.IdVehicleType
            </GridColumn>
            <GridColumn TItem="VehicleListCLS" HeaderText="Descripción" PropertyName="OpcionName">
                @context.DscriptionVehicle
            </GridColumn>
            <GridColumn TItem="VehicleListCLS" HeaderText="ItemCode" PropertyName="OpcionName">
                @context.ItemCode
            </GridColumn>
            <GridColumn TItem="VehicleListCLS" Filterable="false" HeaderText="Operaciones" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                <Button @onclick="@(() => editar(@context.IdVehicleType))" Color="ButtonColor.Warning" Size="ButtonSize.Small"><Icon Name="IconName.PencilFill" /></Button>
                <Button @onclick="@(() => eliminar(@context.IdVehicleType))" Color="ButtonColor.Danger" Size="ButtonSize.Small"><Icon Name="IconName.Trash2Fill" /></Button>
            </GridColumn>
        </GridColumns>

    </Grid>
}

@code {
    public List<VehicleListCLS> lista; 
    private IEnumerable<VehicleListCLS> TipoVehiculo = default!;
    private Grid<VehicleListCLS> miGrid; // Asegúrate de que el tipo corresponda al componente
    //esto es para las alertas.
    List<ToastMessage> messages = new List<ToastMessage>();
    private void ShowMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => messages.Add(CreateToastMessage(toastType, titulo, textosecundario, mensaje));
    //fin para las alertas.

    private ToastMessage CreateToastMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => new ToastMessage
        {
            Type = toastType,
            Title = titulo,
            HelpText = textosecundario,
            Message = mensaje,
        };

    protected override async Task OnInitializedAsync()
    {
        lista = await oVehicleTypeServices.listar();
        oVehicleTypeServices.OnChange += refrezcarLista;
    }


    private async Task<GridDataProviderResult<VehicleListCLS>> VehiculoDataProvider(GridDataProviderRequest<VehicleListCLS> request)
    {
        //if (Usuarios is null) // pull employees only one time for client-side filtering, sorting, and paging
        TipoVehiculo = lista; // call a service or an API to pull the employees
        return await Task.FromResult(request.ApplyTo(TipoVehiculo));

    }

    public async Task refrezcarLista()
    {
        lista = await oVehicleTypeServices.listar();
        TipoVehiculo = lista;
        // Llama al método de refresco del grid (si el grid lo expone)
        await miGrid.RefreshDataAsync(); // o Refresh() según lo que ofrezca la librería
        StateHasChanged();
    }


    private async Task editar(int id)
    {
        oVehicleTypeServices.notificarEdit(id);
        await Task.CompletedTask;
    }

    private async Task eliminar(int id)
    {
        bool exito = await oVehicleTypeServices.eliminar(id);
        if (exito == true)
        {
            ShowMessage(ToastType.Success, "Tipo Vehiculo Molit", $"Molit - {DateTime.Now}", $"Registro se ha eliminado correctamente! - {DateTime.Now}");
        }
        else
        {
            ShowMessage(ToastType.Success, "Tipo Vehiculo Molit", $"Molit:Error - {DateTime.Now}", $"Error: No se ha podido eliminar el registro - {DateTime.Now}");
        }
        await Task.CompletedTask;
    }
}
