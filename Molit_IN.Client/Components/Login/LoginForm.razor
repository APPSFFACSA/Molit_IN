@using Molit_IN.Client.Services
@using Molit_IN.Client.Provider
@using Molit_IN.Library.Login
@using CurrieTechnologies.Razor.SweetAlert2
@using BlazorBootstrap
@using Microsoft.AspNetCore.Components.Forms
@inject LoginServices oLoginServices
@inject NavigationManager Navigation
@inject SweetAlertService Swal
@inject Authentication auth

<div class="login-background">
    <div class="login-container">

        <h3 class="animated-title text-center mb-4">MOLIT IN</h3>

        <EditForm Model="@oLoginCLS" OnValidSubmit="@Login" OnInvalidSubmit="@OnInvalidSubmit">
            <DataAnnotationsValidator />
            @* <ValidationSummary /> *@

            <h2 class="h4 mb-3">Bienvenido</h2>

            <div class="mt-3">
                <label class="form-label">Ingrese nombre de usuario</label>
                <InputText class="form-control" @bind-Value="oLoginCLS.username" disabled="@isBusy" />
                <ValidationMessage For="(()=> oLoginCLS.username)" />
            </div>

            <div class="mt-3">
                <label class="form-label">Ingrese contraseña</label>
                <InputText class="form-control" type="password" @bind-Value="oLoginCLS.password" disabled="@isBusy" />
                <ValidationMessage For="(()=> oLoginCLS.password)" />
            </div>

            <div class="d-flex align-items-center gap-3 mt-4">
                <button type="submit" class="btn btn-success" disabled="@isBusy">
                    @(isBusy ? "Ingresando..." : "Ingresar")
                </button>

                <Spinner Class="me-3"
                         Type="SpinnerType.Dots"
                         Color="SpinnerColor.Success"
                         Size="SpinnerSize.Large"
                         Visible="@isBusy" />
            </div>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger alert-dismissible fade show animate__animated animate__shakeX mt-3" role="alert">
                    <strong>Error:</strong> @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </EditForm>

    </div>
</div>

@code {
    // Modelo de login (usa tu clase con DataAnnotations en Molit_IN.Library.Login)
    private LoginCLS oLoginCLS { get; set; } = new();
    private string? error;
    private bool isBusy = false;

    private async Task Login()
    {
        isBusy = true;
        error = null;

        try
        {
            var token = await oLoginServices.login(oLoginCLS);

            if (!string.IsNullOrWhiteSpace(token))
            {
                // Actualiza el estado de autenticación y navega
                await auth.Entrar(token);
                Navigation.NavigateTo("/home", forceLoad: true);
            }
            else
            {
                error = "Usuario o contraseña inválidos";
              //  await Swal.FireAsync("Credenciales inválidas", "Verifica tu usuario y contraseña.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            error = "Ocurrió un error al iniciar sesión.";
            await Swal.FireAsync("Error", error, SweetAlertIcon.Error);
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private async Task OnInvalidSubmit(EditContext context)
    {
        await Swal.FireAsync("Formulario incompleto", "Por favor, completa los campos requeridos.", SweetAlertIcon.Warning);
    }
}