@inject PilotServices oPilotServices
@inject IYourImageService servicio

@if (lista is null)
{
    <h3>Cargando...</h3>
}
else
{
    <Grid TItem="PilotListCLS"
          @ref="miGrid"
          Class="table table-hover table-bordered table-striped table-sm"
          DataProvider="PilotDataProvider"
          AllowPaging="true"
          PageSize="10"
          AllowFiltering="true"
          Responsive="true">
        <GridColumns>
            <GridColumn TItem="PilotListCLS" HeaderText="Id" Filterable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.PilotId
            </GridColumn>
            <GridColumn TItem="PilotListCLS" HeaderText="Nombre Completo" PropertyName="FullName">
                @context.FullName
            </GridColumn>
            <GridColumn TItem="PilotListCLS" HeaderText="Tipo de Licencia" PropertyName="LicenseType" TextAlignment="Alignment.Center">
                @context.LicenseType
            </GridColumn>
            <GridColumn TItem="PilotListCLS" HeaderText="No. Licencia" PropertyName="LicenseNumber">
                @context.LicenseNumber
            </GridColumn>
            <GridColumn TItem="PilotListCLS" Filterable="false" HeaderText="Operaciones" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                <Button @onclick="@(() => editar(@context.PilotId))" Color="ButtonColor.Warning" Size="ButtonSize.Small"><Icon Name="IconName.PencilFill" /></Button>
                <Button @onclick="@(() => eliminar(@context.PilotId))" Color="ButtonColor.Danger" Size="ButtonSize.Small"><Icon Name="IconName.Trash2Fill" /></Button>
            </GridColumn>
        </GridColumns>
    </Grid>
}

@code {
    [Parameter] public string branchcode { get; set; }

    //Callback al padre
    [Parameter] public EventCallback<ToastMessage> OnToast { get; set; }

    public List<PilotListCLS> lista;
    private IEnumerable<PilotListCLS> Pilot = default!;
    private Grid<PilotListCLS> miGrid;

    protected override async Task OnInitializedAsync()
    {
        lista = await oPilotServices.listar(branchcode);
        oPilotServices.OnChange += refrezcarLista;
    }

    public async Task refrezcarLista()
    {
        lista = await oPilotServices.listar(branchcode);
        Pilot = lista;
        if (miGrid is not null) await miGrid.RefreshDataAsync();
        StateHasChanged();
    }

    private Task<GridDataProviderResult<PilotListCLS>> PilotDataProvider(GridDataProviderRequest<PilotListCLS> request)
    {
        Pilot = lista;
        return Task.FromResult(request.ApplyTo(Pilot));
    }

    private Task editar(int id)
    {
        oPilotServices.notificarEdit(id);
        return Task.CompletedTask;
    }

    private async Task eliminar(int idpilot)
    {
        bool ok = await oPilotServices.eliminar(idpilot);
        await OnToast.InvokeAsync(new ToastMessage
            {
                Type = ok ? ToastType.Success : ToastType.Danger,
                Title = "Piloto Molit",
                HelpText = $"Molit - {DateTime.Now}",
                Message = ok ? "Registro se ha eliminado correctamente" : "Error: No se ha podido eliminar el registro"
            });
    }
}
