@* @inject SupplierServices oSupplierServices *@
@inject PilotServices oPilotServices
@inject IYourImageService servicio
@implements IDisposable

@if (oPilot is null)
{
    <h3>Cargando...</h3>
}
else
{
    <EditForm Model="@oPilot" OnValidSubmit="@guardar">
        <DataAnnotationsValidator />
        <div class="mt-3">
            <label>Id Piloto</label>
            <NumberInput readonly class="form-control" @bind-Value="oPilot.PilotId" />
        </div>

        <div class="mt-3">
            <label>Nombre Completo</label>
            <TextInput class="form-control" @bind-Value="oPilot.FullName" />
            <ValidationMessage For="(()=>oPilot.FullName)" />
        </div>

        <div class="mt-3">
            <label>Edad</label>
            <NumberInput class="form-control" @bind-Value="oPilot.Age" />
        </div>

        <div class="mt-3">
            <label>Seleccione Tipo De Licencia</label>
            <InputSelect @bind-Value="oPilot.LicenseType" class="form-control">
                <option value="0">--Seleccione--</option>
                <option value="A">Tipo A</option>
                <option value="B">Tipo B</option>
                <option value="C">Tipo C</option>
                <option value="M">Tipo M</option>
                <option value="E">Tipo E</option>
            </InputSelect>
        </div>

        <div class="mt-3">
            <label>No. Licencia</label>
            <TextInput class="form-control" @bind-Value="oPilot.LicenseNumber" />
            <ValidationMessage For="(()=>oPilot.LicenseNumber)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Foto de Licencia</label>
            <InputFile @key="fileInputKey" OnChange="OnFilesUploading" class="form-control" />
        </div>

        @if (!string.IsNullOrEmpty(imagePreview))
        {
            <div class="mb-3">
                <img src="@imagePreview" width="200" height="200" class="img-thumbnail" />
            </div>
        }

        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Guardar</button>
            <button class="btn btn-warning" @onclick="limpiar" type="button">Limpiar</button>
        </div>

        <Spinner Class="me-3" Type="SpinnerType.Dots" Color="SpinnerColor.Success" Size="SpinnerSize.Large" Visible="@visible" />
    </EditForm>
}

@code {
    [Parameter] public string branchcode { get; set; }

    // 🔔 Callback para pedir al padre que muestre un toast
    [Parameter] public EventCallback<ToastMessage> OnToast { get; set; }

    private string? imagePreview;
    public PilotFormAddCLS oPilot;
    // Este GUID se usa para invalidar el <InputFile>
    private Guid fileInputKey = Guid.NewGuid();
    private bool visible = false;

    protected override async Task OnInitializedAsync()
    {
        oPilotServices.OnEdit += recuperar;
        oPilot = new PilotFormAddCLS();
        StateHasChanged();
        await Task.CompletedTask;
    }

    public void Dispose() => oPilotServices.OnEdit -= recuperar;

    private async Task guardar()
    {
        visible = true;
        try
        {
            oPilot.BranchCode = branchcode;
            var ok = await oPilotServices.agregar(oPilot);
            if (ok)
            {
                await OnToast.InvokeAsync(new ToastMessage
                    {
                        Type = ToastType.Success,
                        Title = "Piloto Molit",
                        HelpText = $"Molit - {DateTime.Now}",
                        Message = oPilot.PilotId > 0 ? "Registro actualizado correctamente" : "Registro agregado correctamente"
                    });

                ClearImage();
            oPilot = new PilotFormAddCLS();
            }
            else
            {
                await OnToast.InvokeAsync(new ToastMessage
                    {
                        Type = ToastType.Danger,
                        Title = "Piloto Molit",
                        HelpText = $"Molit:Error - {DateTime.Now}",
                        Message = "Error: No se ha podido guardar el registro"
                    });
            }
        }
        finally
        {
            visible = false;
        }
    }

    private Task limpiar()
    {
        oPilot = new PilotFormAddCLS();
        ClearImage();
        return Task.CompletedTask;
    }

    private async Task recuperar(int id)
    {
        var data = await oPilotServices.recuperar(id);
        oPilot = data ?? new PilotFormAddCLS();
        imagePreview = servicio.VisualizarImagen(oPilot.NamePhoto, oPilot.LicensePhoto);
        StateHasChanged();
    }

    protected async Task OnFilesUploading(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Validación opcional de tamaño antes de leer
        if (file.Size > 15_000_000)
        {
            await OnToast.InvokeAsync(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Archivo demasiado grande",
                    HelpText = "Límite 15 MB",
                    Message = $"El archivo {file.Name} excede el tamaño permitido."
                });
            return;
        }

        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 15_000_000).CopyToAsync(ms);

        oPilot.LicensePhoto = ms.ToArray();
        oPilot.NamePhoto = file.Name;
        imagePreview = servicio.VisualizarImagen(oPilot.NamePhoto, oPilot.LicensePhoto);
        StateHasChanged();
    }

    private void ClearImage()
    {
        oPilot.LicensePhoto = Array.Empty<byte>();
        oPilot.NamePhoto = null;
        imagePreview = null;
        fileInputKey = Guid.NewGuid();
        StateHasChanged();
    }
}
