@inject UserServices oUserServices
@inject NavigationManager navigationManager

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

@if (lista is null)
{
    <h3>Cargando...</h3>
}
else
{
    <Grid TItem="UserListCLS"
    @ref="miGrid"
          Class="table table-hover table-bordered table-striped table-sm"
    DataProvider="UsersDataProvider"
    AllowPaging="true"
    PageSize="10"
    AllowFiltering="true"
    Responsive="true">

        <GridColumns>
            <GridColumn TItem="UserListCLS" HeaderText="Id" Filterable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.IdUser
            </GridColumn>
            <GridColumn TItem="UserListCLS" HeaderText="Nombre Completo" PropertyName="FullName">
                @context.FullName
            </GridColumn>
            <GridColumn TItem="UserListCLS" HeaderText="Email" PropertyName="Email">
                @context.Email
            </GridColumn>
            <GridColumn TItem="UserListCLS" HeaderText="Tipo" PropertyName="TypeUser">
                @context.TypeUser
            </GridColumn>
           @*  <GridColumn TItem="UserListCLS" HeaderText="Rol" PropertyName="RoleId" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.RoleId
            </GridColumn> *@
            <GridColumn TItem="UserListCLS" Filterable="false" HeaderText="Operaciones" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                <Button @onclick="@(() => editar(@context.IdUser))" Color="ButtonColor.Warning" Size="ButtonSize.Small"><Icon Name="IconName.PencilFill" /></Button>
                <Button @onclick="@(() => eliminar(@context.IdUser))" Color="ButtonColor.Danger" Size="ButtonSize.Small"><Icon Name="IconName.Trash2Fill" /></Button>
            </GridColumn>
        </GridColumns>

    </Grid>

}
@code {
    public List<UserListCLS> lista; //= new List<UsuarioListCLS>();
    private IEnumerable<UserListCLS> Usuarios = default!;
    private Grid<UserListCLS> miGrid; // Asegúrate de que el tipo corresponda al componente
    //esto es para las alertas.
    List<ToastMessage> messages = new List<ToastMessage>();
    private void ShowMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => messages.Add(CreateToastMessage(toastType, titulo, textosecundario, mensaje));
    //fin para las alertas.

    private ToastMessage CreateToastMessage(ToastType toastType, string titulo, string textosecundario, string mensaje) => new ToastMessage
        {
            Type = toastType,
            Title = titulo,
            HelpText = textosecundario,
            Message = mensaje,
        };

    protected override async Task OnInitializedAsync()
    {
        lista = await oUserServices.listarUsuario();
        oUserServices.OnChange += refrezcarLista;
        oUserServices.OnSerach2 += buscarUsuario;
    }


    private async Task<GridDataProviderResult<UserListCLS>> UsersDataProvider(GridDataProviderRequest<UserListCLS> request)
    {
        //if (Usuarios is null) // pull employees only one time for client-side filtering, sorting, and paging
        Usuarios = lista; // call a service or an API to pull the employees
        return await Task.FromResult(request.ApplyTo(Usuarios));

    }

    public async Task refrezcarLista()
    {
        lista = await oUserServices.listarUsuario();
        Usuarios = lista;
        // Llama al método de refresco del grid (si el grid lo expone)
        await miGrid.RefreshDataAsync(); // o Refresh() según lo que ofrezca la librería
        StateHasChanged();
    }


    private async Task editar(int idusuario)
    {
        oUserServices.notificarEdit(idusuario);
        await Task.CompletedTask;
    }

    private async Task eliminar(int idusuario)
    {
        bool exito = await oUserServices.eliminar(idusuario);
        if (exito == true)
        {
            ShowMessage(ToastType.Success, "Usuario Molit", $"Molit - {DateTime.Now}", $"Registro se ha eliminado correctamente! - {DateTime.Now}");
        }
        else
        {
            ShowMessage(ToastType.Success, "Usuario Molit", $"Molit:Error - {DateTime.Now}", $"Error: No se ha podido eliminar el registro - {DateTime.Now}");
        }
        await Task.CompletedTask;
    }


    private async Task buscarUsuario(string nombreusuario)
    {
        lista = await oUserServices.buscarUsuario(nombreusuario);
        StateHasChanged();
    }

}
