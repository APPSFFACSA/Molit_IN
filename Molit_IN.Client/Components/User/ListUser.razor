@implements IDisposable
@inject UserServices oUserServices
@inject NavigationManager navigationManager

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

@if (lista is null)
{
    <h3>Cargando...</h3>
}
else
{
    <Grid TItem="UserListCLS"
          @ref="miGrid"
          Class="table table-hover table-bordered table-striped table-sm"
          DataProvider="UsersDataProvider"
          AllowPaging="true"
          PageSize="10"
          AllowFiltering="true"
          Responsive="true">

        <GridColumns>
            <GridColumn TItem="UserListCLS" HeaderText="Id" Filterable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                @context.IdUser
            </GridColumn>
            <GridColumn TItem="UserListCLS" HeaderText="Nombre Completo" PropertyName="FullName">
                @context.FullName
            </GridColumn>
            <GridColumn TItem="UserListCLS" HeaderText="Email" PropertyName="Email">
                @context.Email
            </GridColumn>
            <GridColumn TItem="UserListCLS" HeaderText="Tipo" PropertyName="TypeUser">
                @context.TypeUser
            </GridColumn>
            <GridColumn TItem="UserListCLS" Filterable="false" HeaderText="Operaciones" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                <Button @onclick="@(() => editar(@context.IdUser))" Color="ButtonColor.Warning" Size="ButtonSize.Small"><Icon Name="IconName.PencilFill" /></Button>
                <Button @onclick="@(() => eliminar(@context.IdUser))" Color="ButtonColor.Danger" Size="ButtonSize.Small"><Icon Name="IconName.Trash2Fill" /></Button>
            </GridColumn>
        </GridColumns>

    </Grid>

}
@code {
    public List<UserListCLS> lista;
    private IEnumerable<UserListCLS> Usuarios = Enumerable.Empty<UserListCLS>();
    private Grid<UserListCLS> miGrid;

    // Alertas
    List<ToastMessage> messages = new();
    private void ShowMessage(ToastType toastType, string titulo, string textosecundario, string mensaje)
        => messages.Add(new ToastMessage { Type = toastType, Title = titulo, HelpText = textosecundario, Message = mensaje });

    protected override async Task OnInitializedAsync()
    {
        lista = await oUserServices.listarUsuario();
        oUserServices.OnChange += refrezcarLista;
        oUserServices.OnSerach2 += buscarUsuario;
    }

    public void Dispose()
    {
        oUserServices.OnChange -= refrezcarLista;
        oUserServices.OnSerach2 -= buscarUsuario;
    }

    private Task<GridDataProviderResult<UserListCLS>> UsersDataProvider(GridDataProviderRequest<UserListCLS> request)
    {
        Usuarios = lista ?? Enumerable.Empty<UserListCLS>();
        return Task.FromResult(request.ApplyTo(Usuarios));
    }

    public async Task refrezcarLista()
    {
        lista = await oUserServices.listarUsuario();
        Usuarios = lista;
        if (miGrid is not null)
            await miGrid.RefreshDataAsync();
        StateHasChanged();
    }

    private Task editar(int idusuario)
    {
        // Notifica al formulario que debe cargar este id
        oUserServices.notificarEdit(idusuario); // fire-and-forget
        return Task.CompletedTask;
    }

    private async Task eliminar(int idusuario)
    {
        bool exito = await oUserServices.eliminar(idusuario);
        if (exito)
        {
            ShowMessage(ToastType.Success, "Usuario Molit", $"Molit - {DateTime.Now}", $"Registro se ha eliminado correctamente!");
            await refrezcarLista(); // asegurar refresco inmediato
        }
        else
        {
            ShowMessage(ToastType.Danger, "Usuario Molit", $"Molit:Error - {DateTime.Now}", $"Error: No se ha podido eliminar el registro");
        }
    }

    private async Task buscarUsuario(string nombreusuario)
    {
        lista = await oUserServices.buscarUsuario(nombreusuario);
        if (miGrid is not null)
            await miGrid.RefreshDataAsync();
        StateHasChanged();
    }
}
